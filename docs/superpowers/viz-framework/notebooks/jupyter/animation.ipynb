   "source": [
    "# Animation — Electromagnetic Wave Propagation\n",
    "\n",
    "This notebook uses **Manim** (Community Edition) to render an electromagnetic wave propagating through space, showing the orthogonal relationship between **E** and **B** fields.\n",
    "\n",
    "Physics grounding: $\mathbf{E} \perp \mathbf{B} \perp \mathbf{k}$ and $c = 1/\sqrt{\mu_0 \varepsilon_0}$"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Ensure manim is installed: pip install manim\n",
    "import manim\n",
    "print('Manim version:', manim.__version__)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "%%manim -qm WavePropagation\n",
    "\n",
    "from manim import *\n",
    "\n",
    "class WavePropagation(Scene):\n",
    "    def construct(self):\n",
    "        # Axes for E (vertical) and B (into page / horizontal offset)\n",
    "        axes = Axes(\n",
    "            x_range=[0, 4*PI, PI],\n",
    "            y_range=[-2, 2, 1],\n",
    "            x_length=10,\n",
    "            y_length=4,\n",
    "            axis_config={'include_tip': False}\n",
    "        )\n",
    "        axes.to_edge(DOWN)\n",
    "        self.add(axes)\n",
    "\n",
    "        # Time-varying sine waves for E and B\n",
    "        t_tracker = ValueTracker(0)\n",
    "\n",
    "        e_wave = always_redraw(\n",
    "            lambda: axes.plot(\n",
    "                lambda x: 1.5 * np.sin(x - t_tracker.get_value()),\n",
    "                color=YELLOW\n",
    "            )\n",
    "        )\n",
    "        b_wave = always_redraw(\n",
    "            lambda: axes.plot(\n",
    "                lambda x: 1.5 * np.cos(x - t_tracker.get_value() + PI/2),\n",
    "                color=BLUE\n",
    "            )\n",
    "        )\n",
    "\n",
    "        e_label = MathTex('\\mathbf{E}', color=YELLOW).next_to(axes, UP, buff=0.3)\n",
    "        b_label = MathTex('\\mathbf{B}', color=BLUE).next_to(axes, UP, buff=0.3).shift(RIGHT*2)\n",
    "\n",
    "        self.add(e_wave, b_wave, e_label, b_label)\n",
    "        self.play(t_tracker.animate.set_value(2*PI), run_time=4, rate_func=linear)\n",
    "        self.wait()\n",
    "\n",
    "        # Annotation callout\n",
    "        callout = Tex('E and B are in phase, orthogonal').scale(0.7).to_edge(UP)\n",
    "        self.play(FadeIn(callout))\n",
    "        self.wait(1)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Expected Output\n",
    "\n",
    "A rendered MP4 video (medium quality, `-qm`) showing:\n",
    "1. A yellow sine wave (E-field) and a blue cosine wave (B-field) traveling right\n",
    "2. A text callout confirming the orthogonal, in-phase relationship\n",
    "\n",
    "The `%%manim` magic auto-embeds the video in the notebook output."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Interactive playback speed toggle using ipywidgets\n",
    "from ipywidgets import Video, FloatSlider, VBox, HBox\n",
    "from IPython.display import display\n",
    "import glob\n",
    "\n",
    "# Find the most recent manim render\n",
    "videos = glob.glob('media/videos/**/*.mp4', recursive=True)\n",
    "if videos:\n",
    "    video_path = max(videos, key=lambda p: os.path.getmtime(p) if os.path.exists(p) else 0)\n",
    "    v = Video.from_file(video_path, width=640, height=360)\n",
    "    speed = FloatSlider(min=0.25, max=2.0, step=0.25, value=1.0, description='Speed')\n",
    "    display(VBox([v, speed]))\n",
    "else:\n",
    "    print('Render the %%manim cell above first.')"
   ]
  }
