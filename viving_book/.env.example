# Drill-Down Explainer Configuration

# Image generation provider: "gemini" or "minimax"
IMAGE_PROVIDER=gemini

# ── Gemini ──────────────────────────────────────────────────────────────────
# Required if IMAGE_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-image-preview

# ── MiniMax ─────────────────────────────────────────────────────────────────
# Required if IMAGE_PROVIDER=minimax
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_MODEL=image-01

# Server port
PORT=3000

# Cache version - bump this to invalidate all cached generations
CACHE_VERSION=1

# Model call timeout in milliseconds
MODEL_TIMEOUT_MS=120000
